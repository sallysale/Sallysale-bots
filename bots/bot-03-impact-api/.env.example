# BOT-03 — Impact.com API
# העתק לקובץ .env ומלא את הערכים האמיתיים

# Supabase — נדרש לכל הבוטים
SUPABASE_URL=https://jmfstybgwslpvpemdbrk.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Impact.com — https://app.impact.com/secure/mediapartner/apis.ihtml
# Account SID מתוך פאנל Impact (Settings → API)
IMPACT_ACCOUNT_SID=your_account_sid_here

# Auth Token מתוך פאנל Impact (Settings → API)
IMPACT_AUTH_TOKEN=your_auth_token_here
