# BOT-31 — Telegram Bot — Environment Variables
# העתק לקובץ .env והכנס ערכים אמיתיים.

# Supabase (חובה)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Telegram (חובה)
# BOT_TOKEN — מ-@BotFather ב-Telegram
# CHANNEL_ID — @channelname או -100XXXXXXXXXX (chat_id מספרי)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHANNEL_ID=@sallysale
