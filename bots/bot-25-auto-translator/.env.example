SUPABASE_URL=https://jmfstybgwslpvpemdbrk.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# DeepL API — נדרש לתרגום
# Free tier:  https://www.deepl.com/pro#developer → DeepL API Free
# Pro tier:   https://www.deepl.com/pro            → DeepL API Pro (תומך בעברית)
DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# הגדר true רק אם יש לך DeepL Pro (תומך בעברית + מכסה גבוהה)
# false = DeepL Free (ללא עברית, 500,000 תווים/חודש חינם)
DEEPL_PRO=false
