# BOT-10 — Scraping Tier 2 — Environment Variables
# העתק לקובץ .env והכנס ערכים אמיתיים.
# לעולם אל תעלה .env ל-GitHub!

# Supabase (חובה)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ScraperAPI (חובה לscraping)
# הרשם ב: https://www.scraperapi.com — $49/חודש
SCRAPERAPI_KEY=your-scraperapi-key-here
