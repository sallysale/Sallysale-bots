# BOT-07 — eBay EPN Finding API
# העתק לקובץ .env ומלא את הערכים האמיתיים

# Supabase — נדרש לכל הבוטים
SUPABASE_URL=https://jmfstybgwslpvpemdbrk.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# eBay Developer Account — https://developer.ebay.com
# App ID (Client ID) מתוך Application Keys
EBAY_APP_ID=YourApp-YourApp-PRD-xxxxxxxxxxxx-xxxxxxxx

# eBay Partner Network — https://partnernetwork.ebay.com
# Campaign ID מתוך פאנל EPN
EBAY_CAMPAIGN_ID=5338xxxxxxxxx
